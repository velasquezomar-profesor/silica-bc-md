integrator = md
dt         = 0.002
nsteps     = 50000
nstxout-compressed = 0
nstenergy  = 500
nstlog     = 500
gen_vel    = yes
gen_temp   = 298.0
gen_seed   = 1
pcoupl     = no
cutoff-scheme            = Verlet
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
verlet-buffer-tolerance  = 0.005
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = 298.0
nstcomm                  = 100
comm-mode                = Linear
