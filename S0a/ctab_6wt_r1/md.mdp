integrator = md
dt         = 0.030
nsteps     = 100000
nstxout-compressed = 33333
compressed-x-grps  = System
nstenergy  = 5000
nstlog     = 5000
continuation = yes
pcoupl     = parrinello-rahman
pcoupltype = isotropic
tau_p      = 12.0
compressibility = 3e-4
ref_p      = 1.0
cutoff-scheme            = Verlet
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
verlet-buffer-tolerance  = 0.005
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = 298.0
nstcomm                  = 100
comm-mode                = Linear
