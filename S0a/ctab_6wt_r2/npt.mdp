integrator = md
dt         = 0.002
nsteps     = 100000
nstenergy  = 500
nstlog     = 500
continuation = yes
pcoupl     = c-rescale
pcoupltype = isotropic
tau_p      = 4.0
compressibility = 3e-4
ref_p      = 1.0
cutoff-scheme            = Verlet
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw_type                 = cutoff
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.1
verlet-buffer-tolerance  = 0.005
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
ref_t                    = 298.0
nstcomm                  = 100
comm-mode                = Linear
